#include <windows.h>

/* Built by the "Create .ico from PNG" CI step before this file gets
 * compiled -- gives openmortal.exe its own Explorer icon, and also
 * covers the uninstaller: InnoSetup's UninstallDisplayIcon just points
 * at the exe, so without an icon embedded here that entry in Add/Remove
 * Programs was blank. */
IDI_ICON1 ICON "../packaging/openmortal.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,7,30,0
 PRODUCTVERSION 0,7,30,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenMortal Team"
            VALUE "FileDescription", "OpenMortal - a humorous parody of Mortal Kombat"
            VALUE "FileVersion", "0.7.30.0"
            VALUE "InternalName", "openmortal"
            VALUE "LegalCopyright", "Copyright (C) 2003-2024 OpenMortal Team"
            VALUE "OriginalFilename", "openmortal.exe"
            VALUE "ProductName", "OpenMortal"
            VALUE "ProductVersion", "0.7.30.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
